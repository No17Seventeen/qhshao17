---
import { nav, profile, routeSlugs } from "../data/site.js";

const { lang = "en" } = Astro.props;
const labels = nav[lang];
const base = import.meta.env.BASE_URL;
const pathFor = (page) => {
  const slug = routeSlugs[page];
  return `${base}${lang}/${slug ? `${slug}/` : ""}`;
};
---

<footer class="site-footer">
  <div class="content-shell footer-grid">
    <div>
      <h2>{lang === "zh" ? "个人主页" : "Personal Homepage"}</h2>
      <p class="footer-note">
        {
          lang === "zh" ? (
            <>
              这里记录我的研究历程、工程作品和一些笔记。<br />
              欢迎联系交流。
            </>
          ) : (
            <>
              A record of my research trajectory, engineering work, and notes.<br />
              Research conversations are welcome.
            </>
          )
        }
      </p>
    </div>
    <div class="footer-links">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <button type="button" class="copy-button" data-copy-email={profile.email}>
        {lang === "zh" ? "复制邮箱" : "Copy email"}
      </button>
      <a href={profile.githubUrl}>{profile.githubLabel}</a>
      <a href={pathFor("cv")}>{labels.cv}</a>
    </div>
  </div>
</footer>
