---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { home, research, projects, profile, routeSlugs } from "../../data/site.js";

const lang = "en";
const data = home[lang];
const base = import.meta.env.BASE_URL;
const researchHref = `${base}${lang}/${routeSlugs.research}/`;
const cvHref = `${base}assets/qihao-shao-cv-public.pdf`;
---

<BaseLayout
  title="Qihao Shao"
  description="Academic homepage of Qihao Shao, focusing on Agent Memory Benchmark research and reliable LLM agents."
  lang={lang}
  active="home"
>
  <section class="page-hero">
    <div class="content-shell hero-grid">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h1>{data.name}</h1>
        <p class="hero-subtitle">{data.subtitle}</p>
        <p class="lede" style="margin-top: 18px;">{data.intro}</p>
        <div class="hero-actions">
          <a class="button primary" href={cvHref}>{data.primaryAction}</a>
          <a class="button secondary" href={researchHref}>{data.secondaryAction}</a>
          <a class="button secondary" href={`mailto:${profile.email}`}>Email</a>
        </div>
      </div>

      <aside class="profile-card" aria-label={data.profileTitle}>
        <img src={`${base}assets/portrait.jpg`} alt="Qihao Shao portrait placeholder" />
        <div class="profile-card-body">
          {data.facts.map(([label, value]) => (
            <div>
              <span class="meta-label">{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
      </aside>
    </div>

    <div class="content-shell snapshot-grid">
      {data.snapshots.map(([label, value]) => (
        <div class="snapshot-card">
          <span class="tag-label">{label}</span>
          <strong>{value}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell two-column">
      <div class="section-heading">
        <p class="eyebrow">Research Thread</p>
        <h2>{research.en.title}</h2>
      </div>
      <div>
        <p class="lede">{research.en.summary}</p>
        <ul class="tag-list" style="margin-top: 22px;">
          {research.en.metrics.slice(0, 4).map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell two-column">
      <div class="section-heading">
        <p class="eyebrow">Featured Project</p>
        <h2>{projects.en.featured.name}</h2>
        <p class="muted">{projects.en.featured.context}</p>
      </div>
      <div class="metric-grid">
        {projects.en.featured.metrics.map(([value, label]) => (
          <div class="metric-card">
            <strong>{value}</strong>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
