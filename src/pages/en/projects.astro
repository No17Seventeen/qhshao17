---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/site.js";

const lang = "en";
const data = projects[lang];
const project = data.featured;
---

<BaseLayout
  title="Projects"
  description="Projects by Qihao Shao, including Qwen-vLLM inference optimization."
  lang={lang}
  active="projects"
>
  <section class="page-hero narrow">
    <div class="content-shell academic-section">
      <p class="eyebrow">Research Engineering</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.intro}</p>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell academic-section">
      <article class="academic-entry">
        <h2>{project.name}</h2>
        <div class="project-meta">
          <span>{project.context}</span>
          <span class="project-status">{project.status}</span>
        </div>
        <p class="project-summary" style="margin-top: 16px;">{project.summary}</p>

        <h3>Contributions</h3>
        <ul class="plain-list">
          {project.highlights.map((item) => <li>{item}</li>)}
        </ul>

        <h3>Reported Results</h3>
        <table class="results-table">
          <tbody>
            {project.metrics.map(([value, label]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="entry-meta">Repository: <a href={project.repoUrl}>{project.repoLabel}</a>.</p>
      </article>
    </div>
  </section>
</BaseLayout>
