---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { research } from "../../data/site.js";

const lang = "en";
const data = research[lang];
---

<BaseLayout
  title="Research"
  description="Research thread of Qihao Shao: Agent Memory Benchmark and reliable LLM agent evaluation."
  lang={lang}
  active="research"
>
  <section class="page-hero narrow">
    <div class="content-shell academic-section">
      <p class="eyebrow">{data.kicker}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell academic-section">
      <h2>Research Questions</h2>
      <ol class="numbered-list">
        {data.questions.map((question) => <li>{question}</li>)}
      </ol>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell academic-section">
      <h2>{data.surveyedTitle}</h2>
      <ul class="inline-list">
        {data.surveyed.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell academic-section">
      <h2>{data.methodsTitle}</h2>
      <div class="definition-list">
        {data.methods.map(([title, body], index) => (
          <article class="academic-entry">
            <div>
              <h3>{String(index + 1)}. {title}</h3>
              <p>{body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell academic-section">
      <h2>{data.metricsTitle}</h2>
      <ul class="plain-list columns">
        {data.metrics.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
