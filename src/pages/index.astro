---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Qihao Shao</title>
    <script is:inline define:vars={{ base }}>
      const lang = localStorage.getItem("qhshao17-language") || "en";
      window.location.replace(`${base}${lang}/`);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${base}en/`} />
    </noscript>
  </head>
  <body>
    <p>
      Redirecting to <a href={`${base}en/`}>English</a> /
      <a href={`${base}zh/`}>中文</a>.
    </p>
  </body>
</html>
