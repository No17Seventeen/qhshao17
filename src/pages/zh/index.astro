---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { home, research, projects, profile, routeSlugs } from "../../data/site.js";

const lang = "zh";
const data = home[lang];
const project = projects.zh.featured;
const base = import.meta.env.BASE_URL;
const researchHref = `${base}${lang}/${routeSlugs.research}/`;
const cvHref = `${base}${lang}/${routeSlugs.cv}/`;
const projectResults = project.metrics.map(([value, label]) => `${label}：${value}`).join("；");
---

<BaseLayout
  title="邵启豪"
  description="邵启豪的学术个人主页，关注 Agent Memory Benchmark 与工程化 LLM Agent 评估。"
  lang={lang}
  active="home"
>
  <section class="page-hero academic-hero">
    <div class="content-shell hero-grid">
      <div>
        <p class="eyebrow">{data.eyebrow}</p>
        <h1>{data.name}</h1>
        <p class="hero-subtitle">{data.subtitle}</p>
        <p class="lede" style="margin-top: 18px;">{data.intro}</p>
        <p class="contact-line">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span aria-hidden="true">/</span>
          <a href={profile.githubUrl}>{profile.githubLabel}</a>
          <span aria-hidden="true">/</span>
          <a href={cvHref}>{data.primaryAction}</a>
        </p>
      </div>

      <aside class="profile-card academic-profile" aria-label={data.profileTitle}>
        <img src={`${base}assets/portrait.jpg`} alt="邵启豪个人照片占位" />
        <div class="profile-card-body">
          {data.facts.map(([label, value]) => (
            <div>
              <span class="meta-label">{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell academic-section">
      <h2>研究方向</h2>
      <article class="academic-entry">
        <h3><a href={researchHref}>{research.zh.title}</a></h3>
        <p>{research.zh.summary}</p>
        <ul class="plain-list">
          {research.zh.questions.slice(0, 3).map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section-block">
    <div class="content-shell academic-section">
      <h2>工程实践</h2>
      <article class="academic-entry">
        <h3>{project.name}</h3>
        <p class="entry-meta">{project.context}</p>
        <p>{project.summary}</p>
        <p class="entry-meta">代码仓库：<a href={project.repoUrl}>{project.repoLabel}</a>。</p>
        <p class="entry-meta">结果摘要：{projectResults}。</p>
      </article>
    </div>
  </section>
</BaseLayout>
