---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/site.js";
---

<BaseLayout
  title="联系"
  description="邵启豪的联系方式。"
  lang="zh"
  active="contact"
>
  <section class="page-hero narrow">
    <div class="content-shell two-column">
      <div class="section-heading">
        <p class="eyebrow">联系</p>
        <h1>联系</h1>
      </div>
      <div>
        <p class="lede">
          我希望围绕 agent memory、benchmark 设计、不确定性评估和工程化 agent 开展研究交流。
        </p>
        <div class="contact-details" aria-label="邮箱">
          <div class="contact-detail">
            <span>教育邮箱</span>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <button class="copy-button contact-copy" type="button" data-copy-email={profile.email}>
              复制教育邮箱
            </button>
          </div>
          <div class="contact-detail">
            <span>备用 Gmail</span>
            <a href={`mailto:${profile.backupEmail}`}>{profile.backupEmail}</a>
            <button class="copy-button contact-copy" type="button" data-copy-email={profile.backupEmail}>
              复制 Gmail
            </button>
          </div>
        </div>
        <div class="hero-actions">
          <a class="button primary" href={`mailto:${profile.email}`}>发送教育邮箱</a>
          <a class="button secondary" href={profile.githubUrl}>GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
